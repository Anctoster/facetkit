{
  "name": "facetkit",
  "version": "0.7.0",
  "author": "anctoster",
  "description": "Evidence-first engineering for teams of AI agents: composable skill facets, measuring tools, and one journal from which state, cost, evaluation and the trust in a result are computed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anctoster/facetkit.git"
  },
  "homepage": "https://github.com/Anctoster/facetkit#readme",
  "bugs": {
    "url": "https://github.com/Anctoster/facetkit/issues"
  },
  "bin": { "facet": "bin/facet" },
  "exports": {
    "./facets": "./lib/facets.mjs",
    "./audit": "./lib/audit.mjs",
    "./thrift": "./lib/thrift.mjs",
    "./capsule": "./lib/capsule.mjs",
    "./mutaprobe": "./lib/mutaprobe.mjs",
    "./seams": "./lib/seams.mjs",
    "./receipts": "./lib/receipts.mjs",
    "./uiprobe": "./lib/uiprobe.mjs",
    "./trace": "./lib/trace.mjs",
    "./journal": "./lib/journal.mjs",
    "./flow": "./lib/flow.mjs",
    "./memory": "./lib/memory.mjs",
    "./cost": "./lib/cost.mjs",
    "./eval": "./lib/evalx.mjs",
    "./observe": "./lib/observe.mjs",
    "./retro": "./lib/retro.mjs",
    "./schedule": "./lib/schedule.mjs",
    "./govern": "./lib/govern.mjs",
    "./secscan": "./lib/secscan.mjs",
    "./router": "./lib/router.mjs",
    "./atlas": "./lib/atlas.mjs",
    "./board": "./lib/board.mjs",
    "./skillint": "./lib/skillint.mjs",
    "./lang": "./lib/lang.mjs",
    "./proof": "./lib/proof.mjs",
    "./experiments": "./lib/experiments.mjs",
    "./ownership": "./lib/ownership.mjs",
    "./benchmark": "./lib/benchmark.mjs",
    "./sign": "./lib/sign.mjs",
    "./envinfo": "./lib/envinfo.mjs",
    "./adapt": "./lib/adapt.mjs",
    "./handoff": "./lib/handoff.mjs",
    "./fitness": "./lib/fitness.mjs",
    "./explain": "./lib/explain.mjs",
    "./counterfactual": "./lib/counterfactual.mjs",
    "./crosslearn": "./lib/crosslearn.mjs",
    "./qa": "./lib/qa.mjs",
    "./decisions": "./lib/decisions.mjs"
  },
  "files": ["bin", "lib", "skills", "agents", "commands", "templates", "presets", "trials", "benchmark", "domains", "docs", "examples", "HYPOTHESES.md", "loadouts.json", "README.md", "CHANGELOG.md", "AUDIT.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "facetkit": { "govern": { "scanIgnore": ["test/**", "docs/governance.md"] } },
  "scripts": {
    "test": "node scripts/test.mjs",
    "counts": "node scripts/counts.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "audit": "node bin/facet.mjs audit",
    "benchmark": "node bin/facet.mjs benchmark",
    "demo:proof": "node scripts/demo-proof.mjs",
    "test:viz": "python3 -m unittest discover -s domains/viz/tests",
    "test:arch": "python3 -m unittest discover -s domains/arch/tests"
  },
  "peerDependencies": { "playwright": ">=1.40" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "keywords": ["claude", "agents", "skills", "tdd", "mutation-testing", "handoff", "token-budget"]
}
