{
 "artifacts": ["work/<ITEM>/**"],
 "measure": {
  "note": "How facet origin runs a criterion's check on the state after a step (work/<ITEM>/snap/<step>/, taken by archflow.py when a step starts; the last state is work/<ITEM>/). A command per check id, an id prefix with .*, or * for any: the tool when the state holds its inputs, else the state's own results files (with a receipt); exit 0 holds, 1 does not, 2 cannot say. Placeholders: {python}, {scripts}, {dir} (the state), {check}, {threshold} (--op/--value of the criterion, or nothing).",
  "model.*": "{python} {scripts}/check_one.py {check} {threshold} --in {dir} -- spec_compare.py {dir}/spec.json {dir}/readback.json",
  "spec.*": "{python} {scripts}/check_one.py {check} {threshold} --in {dir} -- model_spec.py {dir}/spec.json",
  "*": "{python} {scripts}/check_one.py {check} {threshold} --in {dir}"
 },
 "chains": {
  "note": "Where a criterion's value comes from, source first (FacetKit plan 2.8, facet origin). links: the step that produces each link. compare: a command, run in the arch folder, exit 0 the same, 1 differs, anything else cannot say; or human - no tool compares that pair. Placeholders: {python}, {scripts} (this folder), {work} (work/<ITEM>), {item}, {criterion}. spec>model expects work/<ITEM>/spec.json and the readback work/<ITEM>/readback.json.",
  "links": {"drawing": {"step": null}, "task": {"step": null}, "spec": {"step": "read"}, "model": {"step": "work"}, "sheets": {"step": "publish"}},
  "compare": {
   "drawing>spec": "human",
   "task>spec": "human",
   "spec>model": "{python} {scripts}/spec_compare.py {work}/spec.json {work}/readback.json",
   "model>sheets": "human"
  }
 },
 "routes": {
  "note": "One route per kind of item. A step with a registered script runs on the smallest model; until one exists the builder writes it. checks = results the inspector must reproduce before PASS.",
  "caps": {
   "runs": 40,
   "minutes": 90
  },
  "rework_max": 2,
  "routes": {
   "estimate": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "estimate",
      "model": "haiku",
      "script": "estimate",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "schedule.inputs",
     "schedule.result"
    ],
    "approve_brief": false
   },
   "intake": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "read",
      "agent": "source-reader",
      "mode": "read",
      "model": "sonnet",
      "gate": "the list of open questions and the interpreted model description"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "spec.schema",
     "spec.scale",
     "spec.layers",
     "spec.stories",
     "spec.walls",
     "spec.loops",
     "spec.openings",
     "spec.zones",
     "spec.confidence",
     "spec.questions"
    ],
    "approve_brief": true
   },
   "model": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "build-model",
      "model": "haiku",
      "script": "build-model",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "spec.questions",
     "model.counts",
     "model.layers",
     "model.dimensions",
     "model.areas"
    ],
    "approve_brief": true
   },
   "sheets-pb": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "layouts",
      "model": "haiku",
      "script": "layouts",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "publish",
      "agent": "model-operator",
      "mode": "publish",
      "model": "haiku",
      "script": "publish",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      },
      "gate": "the sheet list with one preview page per sheet"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "sheets.complete",
     "sheets.naming",
     "sheets.scales",
     "sheets.format",
     "sheets.dwg",
     "titleblock.fields"
    ],
    "approve_brief": true
   },
   "sheets-pw": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "detail",
      "model": "haiku",
      "script": "detail",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "layouts",
      "agent": "model-operator",
      "mode": "layouts",
      "model": "haiku",
      "script": "layouts",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "publish",
      "agent": "model-operator",
      "mode": "publish",
      "model": "haiku",
      "script": "publish",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      },
      "gate": "the sheet list with one preview page per sheet"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "sheets.complete",
     "sheets.naming",
     "sheets.scales",
     "sheets.format",
     "sheets.dwg",
     "titleblock.fields",
     "sheets.trace"
    ],
    "approve_brief": true
   },
   "revise": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "revise",
      "model": "haiku",
      "script": "revise",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "model.layers",
     "model.counts",
     "change.complete",
     "change.declared"
    ],
    "approve_brief": true
   },
   "audit": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "bim.complete",
     "bim.ids"
    ],
    "approve_brief": false
   },
   "variants": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "sketch",
      "agent": "variant-sketcher",
      "mode": "sketch",
      "model": "sonnet",
      "gate": "the comparison of the variants: choose one, or say what the next round should explore"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "variants.inputs",
     "variants.limits",
     "variants.distinct",
     "variants.compared",
     "variants.chosen"
    ],
    "approve_brief": true
   },
   "change": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "change.complete",
     "change.listed"
    ],
    "approve_brief": false
   },
   "rules": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "bim.complete",
     "rules.confirmed",
     "rules.coverage",
     "rules.values"
    ],
    "approve_brief": true
   },
   "trace": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "read",
      "agent": "source-reader",
      "mode": "clauses",
      "model": "sonnet",
      "gate": "the numbered list of clauses of the task and the place that answers each"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "trace.clauses",
     "trace.covered"
    ],
    "approve_brief": true
   },
   "issue": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "outbox.files",
     "outbox.read",
     "outbox.internal"
    ],
    "approve_brief": false
   }
  },
