{
 "routes": {
  "note": "One route per kind of item. A step with a registered script runs on the smallest model; until one exists the builder writes it. checks = results the inspector must reproduce before PASS.",
  "caps": {
   "runs": 40,
   "minutes": 90
  },
  "rework_max": 2,
  "routes": {
   "estimate": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "estimate",
      "model": "haiku",
      "script": "estimate",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "schedule.inputs",
     "schedule.result"
    ],
    "approve_brief": false
   },
   "intake": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "read",
      "agent": "source-reader",
      "mode": "read",
      "model": "sonnet",
      "gate": "the list of open questions and the interpreted model description"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "spec.schema",
     "spec.scale",
     "spec.layers",
     "spec.stories",
     "spec.walls",
     "spec.loops",
     "spec.openings",
     "spec.zones",
     "spec.confidence",
     "spec.questions"
    ],
    "approve_brief": true
   },
   "model": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "build-model",
      "model": "haiku",
      "script": "build-model",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "spec.questions",
     "model.counts",
     "model.layers",
     "model.dimensions",
     "model.areas"
    ],
    "approve_brief": true
   },
   "sheets-pb": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "layouts",
      "model": "haiku",
      "script": "layouts",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "publish",
      "agent": "model-operator",
      "mode": "publish",
      "model": "haiku",
      "script": "publish",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      },
      "gate": "the sheet list with one preview page per sheet"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "sheets.complete",
     "sheets.naming",
     "sheets.scales",
     "sheets.format",
     "sheets.dwg",
     "titleblock.fields"
    ],
    "approve_brief": true
   },
   "sheets-pw": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "detail",
      "model": "haiku",
      "script": "detail",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "layouts",
      "agent": "model-operator",
      "mode": "layouts",
      "model": "haiku",
      "script": "layouts",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "publish",
      "agent": "model-operator",
      "mode": "publish",
      "model": "haiku",
      "script": "publish",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      },
      "gate": "the sheet list with one preview page per sheet"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "sheets.complete",
     "sheets.naming",
     "sheets.scales",
     "sheets.format",
     "sheets.dwg",
     "titleblock.fields",
     "sheets.trace"
    ],
    "approve_brief": true
   },
   "revise": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "work",
      "agent": "model-operator",
      "mode": "revise",
      "model": "haiku",
      "script": "revise",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "full",
      "model": "sonnet"
     }
    ],
    "checks": [
     "model.layers",
     "model.counts"
    ],
    "approve_brief": true
   },
   "audit": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "readback",
      "agent": "model-operator",
      "mode": "readback",
      "model": "haiku",
      "script": "readback",
      "else": {
       "agent": "arch-builder",
       "model": "sonnet"
      }
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [],
    "approve_brief": false
   },
   "variants": {
    "steps": [
     {
      "id": "order",
      "agent": "arch-conductor",
      "mode": "brief",
      "model": "haiku"
     },
     {
      "id": "sketch",
      "agent": "variant-sketcher",
      "mode": "sketch",
      "model": "sonnet",
      "gate": "the comparison of the variants: choose one, or say what the next round should explore"
     },
     {
      "id": "proof",
      "agent": "arch-inspector",
      "mode": "numbers",
      "model": "haiku"
     }
    ],
    "checks": [
     "variants.inputs",
     "variants.limits",
     "variants.distinct",
     "variants.compared",
     "variants.chosen"
    ],
    "approve_brief": true
   }
  },
  "plans": {
   "documentation": [
    [
